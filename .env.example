# Configuracion para Docker (docker compose). Copia este archivo como .env en la raiz.
# El .env real nunca se sube a GitHub.

# Administrador de SQL Server dentro del contenedor.
# Minimo 8 caracteres con mayusculas, minusculas, numeros y simbolos.
SA_PASSWORD=

# Base de datos y usuario de la API (permisos solo de lectura y escritura de datos)
DB_NAME=ContainerTrack
DB_USER=containertrack_app
DB_PASSWORD=

# Firma de las sesiones. Generala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_HOURS=8

# Puerto del sitio en tu equipo: http://localhost:8080
WEB_PORT=8080

# Ponlo en true solo cuando el sitio se sirva con HTTPS
COOKIE_SECURE=false

# Simulador de navegacion
SIMULADOR_ACTIVO=true
SIMULADOR_INTERVALO=60
SIMULADOR_ACELERACION=120
