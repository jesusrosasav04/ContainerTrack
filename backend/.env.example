# Copia este archivo como .env y ajusta los valores.
PORT=3000
CORS_ORIGIN=http://localhost:5173

# SQL Server
DB_SERVER=localhost
# Deja vacio si usas puerto fijo. Para instancia con nombre sin puerto fijo: SQLEXPRESS
DB_INSTANCE=
DB_PORT=1433
DB_NAME=ContainerTrack
DB_USER=containertrack_app
DB_PASSWORD=CambiaEstaContrasena1

# Sesiones. Genera el secreto con: npm run secreto
JWT_SECRET=
SESSION_HOURS=8

# Simulador de navegacion (Nivel 1): mueve los barcos y registra arribos solo
SIMULADOR_ACTIVO=true
SIMULADOR_INTERVALO=60
# Horas simuladas por hora real (120 = 1 minuto real equivale a 2 horas de navegacion)
SIMULADOR_ACELERACION=120
